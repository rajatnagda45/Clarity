# OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Two-signal verifier
NLI_PROVIDER=hosted
NLI_MODEL=
ABSTAIN_THRESHOLD=0.55

# Eval / CI quality gate
EVAL_FAITHFULNESS_MIN=0.85
EVAL_CATCH_RATE_MIN=0.80
EVAL_GOLDEN_PATH=backend/services/eval/golden/cases

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=clarity
PINECONE_DIM=1536

# Cohere
COHERE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clarity-docs
MAX_UPLOAD_BYTES=52428800
INGESTION_LEASE_SECONDS=900
PARSER_VERSION=a3.v1
CHUNK_VERSION=a4.v1
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
EMBEDDING_PROVIDER=openai
EMBEDDING_VERSION=a5.v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_LEASE_SECONDS=900
EMBEDDING_COST_PER_1K_TOKENS_USD=0.0
PERSIST_EMBEDDING_VECTORS_LOCALLY=true
INDEX_PROVIDER=pinecone
INDEX_BATCH_SIZE=100
INDEX_MAX_RETRIES=3
INDEX_TIMEOUT_SECONDS=30
INDEX_LEASE_SECONDS=900
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_FINAL_TOP_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_CROSS_REFERENCE_LIMIT=2
RETRIEVAL_CACHE_TTL_SECONDS=60
WRITER_PROMPT_VERSION=a8.writer.v1
WRITER_VERSION=a8.writer.v1
ANSWER_STREAM_TOKEN_BATCH_SIZE=12
ANSWER_MAX_HISTORY_MESSAGES=8
LLM_PROMPT_COST_PER_1K_TOKENS_USD=0.0
LLM_COMPLETION_COST_PER_1K_TOKENS_USD=0.0

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clarity

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry (optional)
SENTRY_DSN=
