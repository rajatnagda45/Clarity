# OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Two-signal verifier
NLI_PROVIDER=hosted
NLI_MODEL=
ABSTAIN_THRESHOLD=0.55

# Eval / CI quality gate
EVAL_FAITHFULNESS_MIN=0.85
EVAL_CATCH_RATE_MIN=0.80
EVAL_GOLDEN_PATH=backend/services/eval/golden/cases

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=clarity
PINECONE_DIM=1536

# Cohere
COHERE_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clarity-docs
MAX_UPLOAD_BYTES=52428800
INGESTION_LEASE_SECONDS=900

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clarity

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry (optional)
SENTRY_DSN=
